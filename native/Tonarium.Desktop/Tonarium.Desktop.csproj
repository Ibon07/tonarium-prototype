<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/favicon.ico</ApplicationIcon>
    <AssemblyName>Tonarium</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/fonts/**" />
    <None Update="Assets/fonts/*OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Tonarium.Unity/Assets/Resources/OekakiGeometry.json" LogicalName="Tonarium.OekakiGeometry.json" />
    <EmbeddedResource Include="../../client/public/oekaki/sample.png" LogicalName="Tonarium.OekakiSample.png" />
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Livekit.Rtc.Dotnet" Version="0.1.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../client/public/brand/**" Link="Assets/brand/%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../client/public/oekaki/sample.png" Link="Assets/oekaki/sample.png" />
  </ItemGroup>
  <Target Name="UseOnlyWebViewCore" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
</Project>
