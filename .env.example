# 手元の LiveKit（npm run livekit で起動する開発用サーバー）
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LiveKit Cloud を使う場合はプロジェクト設定の値に置き換える
# LIVEKIT_URL=wss://your-project.livekit.cloud
# 部屋の名前の頭（tonarium-<セッション ID>）。同じ LiveKit を別のワークツリーと共有するときに変える
# LIVEKIT_ROOM_PREFIX=tonarium
# セッション内のデータ同期。既定の接続先・認証情報はサーバー側に同梱。
# 認証情報を変更するときだけ指定する。ブラウザには渡さない。
KOKOSYNC_URL=https://45.77.130.146
KOKOSYNC_USERNAME=
KOKOSYNC_PASSWORD=
# ローカルでは Username: / Password: 行のあるファイルを指定してもよい。
# KOKOSYNC_CREDENTIALS_FILE=C:/Users/neo/GitHub/kokosync/.run/deployment-access.txt
SERVER_PORT=3001
# npm run dev の画面のポート。別のワークツリーと同時に動かすときは SERVER_PORT と一緒にずらす
CLIENT_PORT=5173

# npm run dev（5173）に localhost 以外からアクセスを許可するホスト。カンマ区切り
# 先頭が . ならサブドメインすべて（例: .ngrok-free.app）。* で全ホストを許可
ALLOWED_HOSTS=.trycloudflare.com

# 同じマシンの HTTPS リバースプロキシを使う場合だけ 1。Host を保持し、転送ヘッダーを上書きする。
FANTASY_TRUST_PROXY=0
# Docker/Coolify のプロキシは、サーバーから見える固定 IP をカンマ区切りで指定する。CIDR・ホスト名・* は不可。
FANTASY_TRUSTED_PROXY_IPS=

# RPG 診断は DATA_DIR/fantasy-diagnostics に保存する。閲覧は運営 CLI のみ。
# all: 全 GM/NPC 会話、issues: 問題時、off: 原文なし（メタ情報は残る）。
FANTASY_DIAGNOSTICS_DIALOGUE_MODE=all
FANTASY_DIAGNOSTICS_RETENTION_DAYS=14
FANTASY_DIAGNOSTICS_MAX_FILE_BYTES=4194304
FANTASY_DIAGNOSTICS_MAX_TOTAL_BYTES=67108864
FANTASY_DIAGNOSTICS_MAX_QUEUE=1024
# チャットの自動翻訳。認証情報はサーバーだけで扱う（VITE_を付けない）。
# npm run dev の既定はmock、通常起動の既定はopenai。手順: docs/chat-translation.md
OPENAPI_KEY=
# CHAT_TRANSLATION_PROVIDER=mock
# CHAT_TRANSLATION_MODEL=gpt-4o-mini
# CHAT_TRANSLATION_MOCK_FAILURE=1

# 登録済みアイテム・ワールド・共有システムの翻訳を永続保存する。
# 未指定ならチャットの設定を継承。off は既存の訳文と原文だけを表示する。
# CONTENT_TRANSLATION_PROVIDER=openai
# CONTENT_TRANSLATION_MODEL=gpt-4o-mini
