{
  "name": "tonarium-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "test:updates": "tsx --test client/src/updateFlow.test.ts && node --experimental-test-module-mocks --test client/src/updateRecovery.test.mjs client/src/updateRecording.test.mjs",
    "test:share": "tsx --test client/src/shareAnnotations.test.ts",
    "items:png": "node scripts/rasterize-items.mjs",
    "dev": "concurrently -k -n server,client \"tsx watch --include sessions.json server/index.ts --dev\" \"vite\"",
    "dev:systems": "tsx scripts/system-playtest.ts",
    "test:systems-playtest": "tsx --test scripts/system-playtest.test.ts client/src/systems/bindings.test.ts client/src/systems/seat-input.test.ts client/src/systems/catalog-example.test.ts client/src/systems/map-items.test.ts client/src/systems/command-queue.test.ts client/src/systems/localization.test.tsx client/src/systems/pagination.test.tsx client/src/view3d/seatedPose.test.ts",
    "test:systems:integration": "tsx --test server/shared-systems.integration.test.ts",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "livekit": "docker compose -f docker-compose.dev.yml up -d",
    "livekit:stop": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:shared-assets": "tsx --test server/shared-assets.test.ts client/src/shared-assets/loader.test.ts",
    "test:systems": "tsx --test shared/systems.test.ts shared/system-items.test.ts server/system-items.test.ts server/system-runtime.test.ts server/system-catalog.test.ts server/system-service.test.ts shared/system-presentation.test.ts",
    "systems:init": "tsx scripts/systems.ts init",
    "systems": "tsx scripts/systems.ts",
    "systems:validate": "tsx scripts/systems.ts validate",
    "systems:prepare": "tsx scripts/systems.ts prepare",
    "systems:publish": "tsx scripts/systems.ts publish",
    "docs:shared-systems": "tsx scripts/shared-system-docs.ts",
    "check:shared-systems-docs": "tsx scripts/shared-system-docs.ts --check",
    "test:shared-systems-docs": "tsx --test scripts/shared-system-docs.test.ts",
    "test:movement": "tsx --test client/src/movementSettings.test.ts client/src/view3d/movement.test.ts client/src/view3d/movementAbilities.test.ts client/src/view3d/jumpPad.test.ts shared/walking.test.ts",
    "test:camera": "tsx --test client/src/view3d/playerCamera.test.ts client/src/view3d/cityPhysics.test.ts",
    "test:xr": "tsx --test client/src/xr/input.test.ts",
    "test:mirror": "tsx --test client/src/view3d/mirrorReflection.test.ts",
    "test:gif": "tsx --test client/src/view3d/gifPlayback.test.ts client/src/view3d/imageTexture.test.ts",
    "check:changelog": "node scripts/check-changelog.mjs",
    "test:changelog": "node --test scripts/check-changelog.test.mjs scripts/changelog.test.mjs",
    "check:completion": "npm run check:changelog && npm run check:content-locales && npm run typecheck && npm run build",
    "check:content-locales": "tsx scripts/content-translations.ts validate",
    "content:translate": "tsx scripts/content-translations.ts translate",
    "test:content-translations": "tsx --test server/content-translations.test.ts server/content-translation-config.test.ts server/content-translation-sources.test.ts server/content-translations.integration.test.ts client/src/content-translations.test.tsx",
    "test:chess": "tsx --test shared/chess.test.ts server/chess-ai.test.ts",
    "test:sync": "tsx --test shared/session-wire.test.ts shared/session-position.test.ts shared/session-events.test.ts server/ws-heartbeat.test.ts server/thumbnails.test.ts",
    "test:client": "tsx --test client/src/newArrival.test.ts client/src/world/popoverPosition.test.ts client/src/sessionView.test.ts client/src/nearby.test.ts client/src/voiceHeat.test.ts client/src/placesMemo.test.ts client/src/home/changelog.test.ts client/src/homePage.test.ts client/src/i18n/locale.test.ts client/src/i18n/core.test.ts",
    "test:i18n": "tsx --test client/src/i18n/locale.test.ts client/src/i18n/core.test.ts client/src/systems/localization.test.tsx",
    "test:translation": "tsx --test server/translation.test.ts client/src/translation.test.ts client/src/TranslatedText.test.tsx server/translation.integration.test.ts",
    "test:session-actions": "node --experimental-test-module-mocks --test client/src/actions.test.mjs client/src/net/ws.test.mjs",
    "test:sync:integration": "tsx --test server/session.integration.test.ts",
    "electron:dev": "npm --prefix electron start",
    "electron:test": "npm --prefix electron test",
    "electron:build:linux": "npm --prefix electron run build:linux",
    "electron:build:windows": "npm --prefix electron run build:windows",
    "electron:install:linux": "bash electron/install-linux-user.sh",
    "test:emotes": "tsx --test shared/emotes.test.ts",
    "test:avatar": "tsx --test shared/avatar.test.ts",
    "test:market": "tsx --test shared/market.test.ts server/market.test.ts",
    "test:worlds": "tsx --test shared/worlds.test.ts",
    "test:items": "tsx --test shared/items.test.ts",
    "test:telephone": "tsx --test server/telephone.test.ts",
    "test:events": "tsx --test server/events.test.ts",
    "test:hammer": "tsx --test server/hammer.test.ts",
    "test:bike": "tsx --test shared/vehicle.test.ts client/src/view3d/bikePhysics.test.ts",
    "test:survivor": "tsx --test shared/survivor.test.ts server/survivors.test.ts",
    "test:timeline": "tsx --test shared/timeline.test.ts server/follows.test.ts server/timeline.test.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "chess.js": "^1.4.0",
    "dotenv": "^18.0.8",
    "gifuct-js": "^2.1.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
