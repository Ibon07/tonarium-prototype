{
  "name": "tonarium-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch --include sessions.json server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "livekit": "docker compose -f docker-compose.dev.yml up -d",
    "livekit:stop": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:chess": "tsx --test shared/chess.test.ts server/chess-ai.test.ts"
  },
  "dependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "chess.js": "^1.4.0",
    "dotenv": "^18.0.8",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
