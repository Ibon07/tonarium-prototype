# Maintainer: kazu0617 <kazu0617@protonmail.com>
# License metadata is a placeholder until upstream selects a license.
pkgname=tonarium-bin
pkgver=0.0.8
pkgrel=2
pkgdesc='Social spaces with a native 2D client and Unity 3D player'
arch=('x86_64')
url='https://github.com/katteni-kaihatu/tonarium-prototype'
license=('LicenseRef-unknown')
depends=('glibc' 'libgcc' 'libstdc++' 'zlib' 'icu' 'openssl' 'fontconfig'
         'libx11' 'libice' 'libsm' 'libxrandr' 'libxcursor' 'libxi'
         'libglvnd' 'libpulse' 'libvlc' 'vlc-plugins-base' 'vlc-plugin-ffmpeg'
         'python' 'python-gobject' 'glib2' 'gstreamer' 'hicolor-icon-theme' 'gtk3' 'webkit2gtk-4.1'
         'gst-plugins-base' 'gst-plugins-good' 'gst-libav' 'gst-plugin-pipewire'
         'xdg-desktop-portal')
optdepends=('pipewire-pulse: PulseAudio compatibility for PipeWire'
            'xdg-desktop-portal-kde: screen sharing on KDE Plasma'
            'xdg-desktop-portal-gnome: screen sharing on GNOME'
            'xdg-desktop-portal-wlr: screen sharing on wlroots'
            'xorg-xwayland: run the native UI in a Wayland session')
provides=('tonarium')
conflicts=('tonarium')
options=('!strip' '!debug')
_upstream=ecff87d
_archive_root=pr-upstream-linux
source=("$url/releases/download/v$pkgver/Tonarium-$pkgver-upstream-$_upstream-linux-x64.tar.gz")
sha256sums=('847c59c6f53c127bab2f93311e94b77040a6abc87ee9c702d31242eae41ddcd1')

package() {
    install -dm755 "$pkgdir/usr/lib/tonarium" "$pkgdir/usr/bin"
    cp -a --no-preserve=ownership "$srcdir/$_archive_root/." "$pkgdir/usr/lib/tonarium/"
    chmod 755 "$pkgdir/usr/lib/tonarium/Tonarium" "$pkgdir/usr/lib/tonarium/Unity/Tonarium3D.$CARCH"
    ln -s /usr/lib/tonarium/Tonarium "$pkgdir/usr/bin/tonarium"
    install -Dm644 "$srcdir/$_archive_root/tonarium.desktop" "$pkgdir/usr/share/applications/tonarium.desktop"
    install -Dm644 "$srcdir/$_archive_root/tonarium.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/tonarium.png"
    install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
    cp -a --no-preserve=ownership "$srcdir/$_archive_root/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
}
